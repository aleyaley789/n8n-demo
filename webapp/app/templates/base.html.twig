<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Support{% endblock %}</title>
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
            background: #f0f4ff;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem;
            color: #1a202c;
        }

        .card {
            background: #ffffff;
            border-radius: 16px;
            box-shadow: 0 4px 32px rgba(0, 0, 0, 0.08);
            padding: 2.5rem 3rem;
            width: 100%;
            max-width: 560px;
        }

        .card-header {
            margin-bottom: 2rem;
        }

        .card-header h1 {
            font-size: 1.75rem;
            font-weight: 700;
            color: #1a202c;
            margin-bottom: 0.375rem;
        }

        .card-header p {
            color: #718096;
            font-size: 0.9375rem;
        }

        .form-group {
            margin-bottom: 1.5rem;
        }

        label {
            display: block;
            font-size: 0.875rem;
            font-weight: 600;
            color: #374151;
            margin-bottom: 0.5rem;
        }

        label .required {
            color: #e53e3e;
            margin-left: 2px;
        }

        input[type="text"],
        textarea {
            width: 100%;
            padding: 0.75rem 1rem;
            border: 1.5px solid #e2e8f0;
            border-radius: 8px;
            font-size: 1rem;
            color: #1a202c;
            background: #fafafa;
            transition: border-color 0.15s, box-shadow 0.15s, background 0.15s;
            font-family: inherit;
            line-height: 1.5;
        }

        input[type="text"]:focus,
        textarea:focus {
            outline: none;
            border-color: #667eea;
            background: #fff;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.15);
        }

        input[type="text"].is-invalid,
        textarea.is-invalid {
            border-color: #e53e3e;
            background: #fff5f5;
        }

        textarea {
            resize: vertical;
            min-height: 130px;
        }

        .form-errors {
            list-style: none;
            margin-top: 0.375rem;
        }

        .form-errors li {
            color: #c53030;
            font-size: 0.8125rem;
            display: flex;
            align-items: flex-start;
            gap: 0.3rem;
            margin-top: 0.25rem;
        }

        .form-errors li::before {
            content: '!';
            background: #e53e3e;
            color: white;
            border-radius: 50%;
            width: 14px;
            height: 14px;
            min-width: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.6rem;
            font-weight: 700;
            margin-top: 1px;
        }

        .btn-submit {
            width: 100%;
            padding: 0.875rem;
            background: #667eea;
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: background 0.15s, transform 0.1s;
            font-family: inherit;
            letter-spacing: 0.01em;
            margin-top: 0.5rem;
        }

        .btn-submit:hover {
            background: #5a67d8;
        }

        .btn-submit:active {
            transform: scale(0.99);
            background: #4c51bf;
        }

        .success-box {
            text-align: center;
            padding: 1rem 0;
        }

        .success-icon {
            font-size: 3.5rem;
            margin-bottom: 1.25rem;
            display: block;
        }

        .success-box h1 {
            font-size: 1.625rem;
            font-weight: 700;
            margin-bottom: 0.625rem;
        }

        .success-box p {
            color: #718096;
            margin-bottom: 2rem;
            line-height: 1.6;
        }

        .btn-new {
            display: inline-block;
            padding: 0.875rem 2.25rem;
            background: #667eea;
            color: white;
            text-decoration: none;
            border-radius: 8px;
            font-weight: 600;
            font-size: 1rem;
            transition: background 0.15s;
            letter-spacing: 0.01em;
        }

        .btn-new:hover {
            background: #5a67d8;
        }
    </style>
</head>
<body>
    <div class="card">
        {% block body %}{% endblock %}
    </div>
</body>
</html>
