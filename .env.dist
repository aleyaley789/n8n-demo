# Host-Port, unter dem n8n erreichbar ist (http://localhost:<PORT>)
N8N_PORT=5678

# Hostname/Protokoll/Webhook-URL fuer lokalen Betrieb
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/

# Zeitzone fuer Workflows, Cron-Trigger und Logs
GENERIC_TIMEZONE=Europe/Berlin

# Fester Gotify-App-Token, der beim allerersten Start automatisch hinterlegt wird.
# Workflows koennen damit direkt Push-Benachrichtigungen an Gotify senden,
# ohne den Token erst manuell in der Gotify-UI anlegen zu muessen.
GOTIFY_APP_TOKEN=ASupportTicketDemo
