# Host-Port, unter dem n8n erreichbar ist (http://localhost:<PORT>)
N8N_PORT=5678

# Hostname/Protokoll/Webhook-URL fuer lokalen Betrieb
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/

# Zeitzone fuer Workflows, Cron-Trigger und Logs
GENERIC_TIMEZONE=Europe/Berlin

# Verschluesselt gespeicherte Zugangsdaten in der SQLite-DB.
# Mit `openssl rand -hex 32` generieren und danach nicht mehr aendern,
# sonst koennen bestehende Credentials nicht mehr entschluesselt werden.
N8N_ENCRYPTION_KEY=<BITTE_AUSFUELLEN>
